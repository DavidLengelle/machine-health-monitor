# Copy this file to .env and fill in the values. .env is git-ignored.

# LLM backend used by the operator assistant. Only "anthropic" is wired up.
LLM_PROVIDER=anthropic

# Anthropic API credentials for the operator assistant.
# Key format: sk-ant-...  (create one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id for the assistant. claude-sonnet-5 is a good default for an
# interactive helper; use claude-opus-5 if you want deeper analysis.
MODEL_ANTHROPIC=claude-sonnet-5
