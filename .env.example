# Copy this file to .env and fill in the values. .env is git-ignored.

# Which LLM backend the operator assistant talks to. Values: anthropic | ollama
LLM_PROVIDER=anthropic

# Anthropic API key (format sk-ant-...). Required when LLM_PROVIDER=anthropic.
# Left empty in this example on purpose - set it only in your local .env.
ANTHROPIC_API_KEY=

# Anthropic model id used by the assistant, e.g. claude-sonnet-5 (fast,
# the default) or claude-opus-5 (slower, deeper analysis).
MODEL_ANTHROPIC=claude-sonnet-5

# Print prompt-cache token counters after each LLM call. Values: 0 (off) | 1 (on)
DEBUG_TOKENS=0
